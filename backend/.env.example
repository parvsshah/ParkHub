# Database Configuration
# Copy this file to .env and update with your MySQL credentials

# MySQL Connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root2005
DB_NAME=parkhub_db

# Common MySQL passwords:
# - Empty (no password) - default for some installations
# - root - common default password
# - password - another common default
# - Check XAMPP/MAMP control panel if using those

# To find your MySQL password:
# 1. If using Homebrew: password is usually empty or 'root'
# 2. If using XAMPP: usually 'root' or empty
# 3. If using MAMP: check MAMP control panel
# 4. Try connecting: mysql -u root -p
